RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URL=sqlite:///./recovery_agent.db
MOCK_RAZORPAY=true
# Keep true only for local simulator runs. Set false for deployed environments.
ALLOW_TEST_WEBHOOK_BYPASS=true
ENVIRONMENT=development
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Required when exposing dashboard APIs outside a local demo.
DASHBOARD_API_KEY=replace-with-a-strong-dashboard-key
REQUIRE_APPROVAL_OVER_PAISE=1000000
